
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Reglas para la colección de Usuarios
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    // Reglas para la colección de Compañías
    match /companies/{companyId} {
      allow read, write: if request.auth != null;
    }

    // Reglas para la colección de Contactos
    match /contacts/{contactId} {
      allow read, write: if request.auth != null;
    }

    // Reglas para la colección de Tratos
    match /deals/{dealId} {
      allow read, write: if request.auth != null;
    }

    // Reglas para la colección de Interacciones
    match /interactions/{interactionId} {
      allow read, write: if request.auth != null;
    }

    // Reglas para la colección de Buzones de Entrada
    match /inboxes/{inboxId} {
      allow read, write: if request.auth != null;
    }

    // Reglas para la colección de Clientes
    match /customers/{customerId} {
      allow read, write: if request.auth != null;
    }

    // Reglas para la colección de Operaciones
    match /operations/{operationId} {
      allow read, write: if request.auth != null;
    }
  }
}
