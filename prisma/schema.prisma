// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// User model for authentication and ownership
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  password  String   // In a real app, this should be a hashed password
  role      String   @default("ventas") // Add role with default
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bots          Bot[]
  channels      Channel[]
  accounts      PlatformAccount[]
  contacts      Contact[]
  customers     Customer[]
}

// Bot model for Neural Agents
model Bot {
  id            Int      @id @default(autoincrement())
  name          String
  description   String?
  systemPrompt  String
  model         String   @default("gpt-3.5-turbo")
  user          User     @relation(fields: [userId], references: [id])
  userId        Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Channel model for platform integrations
model Channel {
  id            Int      @id @default(autoincrement())
  platform      String
  isActive      Boolean  @default(true)
  accessToken   String?
  verifyToken   String?
  phoneNumberId String?
  user          User     @relation(fields: [userId], references: [id])
  userId        Int
  conversations Conversation[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@unique([platform, userId])
}

// PlatformAccount model for connected accounts
model PlatformAccount {
  id          Int      @id @default(autoincrement())
  platform    String   // e.g., "whatsapp", "instagram"
  accountName String   // e.g., "My Business Page" or "+15551234567"
  accountId   String?  // The unique ID from the platform (e.g., Facebook Page ID)
  accessToken String   // Encrypted access token
  user        User     @relation(fields: [userId], references: [id])
  userId      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// === CRM Models ===

model Contact {
  id         Int      @id @default(autoincrement())
  name       String
  phone      String?  @unique
  email      String?  @unique
  platform   String   // The initial platform the contact was created from
  profilePic String?
  user       User     @relation(fields: [userId], references: [id])
  userId     Int
  conversations Conversation[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Conversation {
  id        Int      @id @default(autoincrement())
  status    String   @default("open")
  contact   Contact  @relation(fields: [contactId], references: [id])
  contactId Int
  channel   Channel  @relation(fields: [channelId], references: [id])
  channelId Int
  messages  Message[]
  lastMessageAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Message {
  id             Int      @id @default(autoincrement())
  content        String
  role           String   // "user" or "assistant"
  sentiment      String?  // e.g., "positive", "negative", "neutral"
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  conversationId Int
  createdAt      DateTime @default(now())
}

model Customer {
  id          Int      @id @default(autoincrement())
  name        String
  email       String?  @unique
  phone       String?
  farmName    String?
  animalCount Int?
  address     String?
  status      String?
  tags        String?
  user        User?    @relation(fields: [userId], references: [id])
  userId      Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
